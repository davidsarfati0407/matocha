# MATOCHA — variables d'environnement (noms uniquement, aucune valeur ici).
# À renseigner dans Vercel > Project > Settings > Environment Variables.

# --- Site -------------------------------------------------------------------
# URL publique, sans slash final (liens des e-mails, redirections).
SITE_URL=
# "true" autorise le mode vente côté déploiement. Le mode ne passe en vente
# qu'avec cette variable ET une demande approuvée dont la checklist passe.
SITE_MODE_SALE_UNLOCK=

# --- Base de données (Supabase) ---------------------------------------------
# Clé service-role : serveur uniquement, jamais exposée au navigateur.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- E-mail (Resend) --------------------------------------------------------
RESEND_API_KEY=
# Expéditeur vérifié, ex. "Matocha <bonjour@domaine-verifie>"
EMAIL_FROM=

# --- Liste d'attente --------------------------------------------------------
# Sel pour l'empreinte des adresses IP (aucune IP stockée en clair).
IP_HASH_SALT=
# Seuil d'erreurs de formulaire sur 10 min qui déclenche form.error_spike (défaut 25).
FORM_ERROR_SPIKE_THRESHOLD=

# --- Back-office /admin -----------------------------------------------------
# Adresses autorisées, séparées par des virgules (David, Gaspard).
ADMIN_EMAILS=
# Secret de signature des liens et sessions (32 caractères minimum).
ADMIN_SESSION_SECRET=

# --- API Ops / agent Instinct ----------------------------------------------
# Limite de requêtes par jeton et par minute (défaut 120).
OPS_RATE_LIMIT_PER_MIN=
# Webhooks sortants vers l'agent (signature HMAC-SHA256).
OPS_WEBHOOK_URL=
OPS_WEBHOOK_SECRET=
# Tentatives maximales et délai de base du rejeu exponentiel (défauts 6 et 30000 ms).
OPS_WEBHOOK_MAX_ATTEMPTS=
OPS_WEBHOOK_BACKOFF_MS=
# Secret du cron qui rejoue les webhooks en échec (/api/cron/webhooks).
CRON_SECRET=

# --- Paiement (mode vente uniquement) --------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Statistiques de visites (facultatif, pour /analytics/summary) --------
PLAUSIBLE_API_KEY=
PLAUSIBLE_SITE_ID=

# --- Développement et tests uniquement (ignorés en production) ------------
# MATOCHA_STORE=memory     stockage en mémoire
# MATOCHA_EMAIL=console    e-mails écrits dans la console
# ADMIN_DEV_LOGIN=true     connexion /admin/dev-login sans e-mail (Playwright)
