{
  "name": "matocha-crm",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rls": "vitest run -c vitest.rls.config.ts",
    "config:check": "tsx config/check.ts",
    "db:seed:gen": "tsx scripts/gen-seed.ts",
    "db:start": "supabase start",
    "db:reset": "pnpm db:seed:gen && supabase db reset",
    "devstack:start": "bash scripts/devstack/start.sh",
    "devstack:reset": "pnpm db:seed:gen && bash scripts/devstack/reset.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.129.0",
    "@react-pdf/renderer": "4.9.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "date-fns": "^4.4.0",
    "exceljs": "4.4.0",
    "geist": "^1.7.2",
    "next": "16.3.0",
    "next-intl": "^4.14.9",
    "pdf-lib": "1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1",
    "server-only": "^0.0.1",
    "three": "0.186.1",
    "zod": "3.25.76",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "22.15.30",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.0",
    "pg": "^8.23.1",
    "supabase": "^2.121.0",
    "tailwindcss": "^4.3.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "^5.0.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@swc/core",
      "@parcel/watcher",
      "unrs-resolver",
      "sharp",
      "supabase"
    ]
  }
