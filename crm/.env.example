# --- Supabase -----------------------------------------------------------------
# Valeurs de démo PUBLIQUES de Supabase local (`supabase start` / stack sans Docker).
# En production : URL et clés du projet (région eu-central-2 Zurich ou eu-central-1 Francfort).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
# Côté serveur uniquement (jamais exposée au navigateur). Utilisée par le seed / la réinitialisation de démo.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
# Temps réel de la map : laisser vide avec Supabase (Realtime). « off » = sondage 1 s,
# pour la stack sans Docker (scripts/devstack) qui n'a pas de serveur Realtime.
NEXT_PUBLIC_REALTIME=
# Connexion Postgres directe (scripts db:*). Supabase CLI : port 54322.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres

# --- IA (assistant + brouillons) — vide = « non configuré », rien de simulé -----
ANTHROPIC_API_KEY=

# --- Intégrations (phase 4) — vides = mode simulé -----------------------------
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
